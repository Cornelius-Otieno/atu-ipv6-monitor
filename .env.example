# Database
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://atu_user:password@127.0.0.1:5433/atu_ipv6?connect_timeout=15

# ETL authentication
ETL_SECRET=your-random-secret-here
CRON_SECRET=your-random-secret-here

# Cloudflare Radar (optional - for traffic share data)
CLOUDFLARE_RADAR_TOKEN=your-cloudflare-radar-api-token

# App
NEXT_PUBLIC_APP_NAME=ATU Africa IPv6 Monitor
NEXTAUTH_URL=http://localhost:3000
